{
  "version": "cone_avoidance_dataset_v1",
  "camera_topic": "/camera/image_raw",
  "steering_topic": "/steering",
  "speed_topic": "/speed",
  "clock_topic": "/clock",
  "odom_topic": "/odom",
  "minimum_drive_speed_mps": 0.10,
  "maximum_steering_age_s": 0.15,
  "maximum_speed_age_s": 0.15,
  "source_width": 480,
  "source_height": 360,
  "source_encoding": "rgb8",
  "roi": {"x_start": 0, "x_end": 480, "y_start": 160, "y_end": 360},
  "output_width": 200,
  "output_height": 66,
  "resize_interpolation": "bilinear",
  "image_format": "PNG",
  "stored_color_space": "RGB",
  "model_color_space": "YUV_BT601_full_range",
  "normalization": "(channel - 0.5) * 2.0",
  "maximum_steering_rad": 0.349066,
  "near_zero_steering_rad": 0.01,
  "saturation_fraction_of_limit": 0.99,
  "preview_frame_count": 9,
  "steering_histogram_bin_edges_rad": [-0.349066, -0.25, -0.15, -0.05, -0.01, 0.01, 0.05, 0.15, 0.25, 0.349066],
  "history_frames": 3,
  "frame_order": ["t_minus_2", "t_minus_1", "t"],
  "maximum_adjacent_gap_s": 0.120,
  "causal_only": true,
  "allow_boundary_crossing": false,
  "allow_duplicate_padding": false,
  "train_episodes": ["cone_episode_001", "cone_episode_002", "cone_episode_003", "cone_episode_004", "cone_episode_005", "cone_episode_006", "cone_episode_007", "cone_episode_008"],
  "validation_episodes": ["cone_episode_009", "cone_episode_010"],
  "holdout_episodes": ["cone_episode_011", "cone_episode_012"],
  "evaluation_regions_s_m": {
    "approach": [3.2, 4.2],
    "departure_avoidance": [4.2, 7.2],
    "pass_return": [7.2, 9.6],
    "recovered": [9.6, 10.6]
  }
}
