scription(Float32MultiArray, '/xycar_motor', self.cb_cmd, 10)"},{"line":53,"text":"self.timer = self.create_timer(1.0, self.tick)"},{"line":54,"text":"self.get_logger().info('data_logger (camera only) ready -> {}'.format(self.csv_path))"},{"line":55,"text":""},{"line":56,"text":"def cb_cmd(self, m):"},{"line":57,"text":"# \uc218\ub3d9\uba85\ub839 \ucf5c\ubc31: \ucd5c\uc2e0 \uc870\ud5a5\u00b7\uc18d\ub3c4\uc640 \uc218\uc2e0 \uc2dc\uac01\uc744 \uae30\ub85d(\ub77c\ubca8\ub85c \uc800\uc7a5\ub420 \uac12)"},{"line":58,"text":"self.angle = float(m.data[0])"},{"line":59,"text":"self.speed = float(m.data[1])"},{"line":60,"text":"self.last_cmd_t = time.time()"},{"line":61,"text":""},{"line":62,"text":"def cb_f(self, msg):"},{"line":63,"text":"# \uce74\uba54\ub77c \ucf5c\ubc31(\uc800\uc7a5 \ud575\uc2ec): \ud504\ub808\uc784\uc744 \ubcf4\uad00\ud558\uace0, \uae30\ub85d \uc911\uc774\uba74 \uc774\ubbf8\uc9c0+\ub77c\ubca8 \ud55c \uc904\uc744 \uc800\uc7a5"},{"line":64,"text":"img = self.bridge.imgmsg_to_cv2(msg, 'bgr8')"},{"line":65,"text":"self.f = cv2.resize(img, (IMG_W, IMG_H))"},{"line":66,"text":"if not self.recording:"},{"line":67,"text":"return"},{"line":68,"text":"name = '{:06d}.jpg'.format(self.count)"},{"line":69,"text":"cv2.imwrite(os.path.join(self.d_f, name), self.f)"},{"line":70,"text":"self.writer.writerow([self.count, name, '{:.4f}'.format(self.angle),"},{"line":71,"text":"'{:.4f}'.format(self.speed), '{:.3f}'.format(time.time())])"},{"line":72,"text":"self.csv.flush()"}],"member":"track_drive/track_drive/data_logger.py"}},"status":"candidate_source_only_not_proven_deployed","teleoperation":{"finding":"Publishes /xycar_motor in a 50 Hz keyboard loop independent of camera.","independent_loop":{"archive":"/home/a/Downloads/TalkFile_track_drive.zip.zip","line_end":159,"line_start":115,"lines":[{"line":115,"text":"while running and rclpy.ok():"},{"line":116,"text":"dt = clock.tick(FPS) / 1000.0"},{"line":117,"text":""},{"line":118,"text":"# \uc774\ubca4\ud2b8 \ucc98\ub9ac: \ud0a4 \ub20c\ub9bc/\ub5cc \uc9d1\ud569 \uac31\uc2e0 + \uc989\uc2dc \uba85\ub839(ESC/SPACE/Q/E) + \ud3ec\ucee4\uc2a4 \uc0c1\uc2e4 \uc2dc \ud0a4 \ucd08\uae30\ud654"},{"line":119,"text":"for e in pygame.event.get():"},{"line":120,"text":"if e.type == pygame.QUIT:"},{"line":121,"text":"running = False"},{"line":122,"text":"elif e.type == pygame.KEYDOWN:"},{"line":123,"text":"held.add(e.key)"},{"line":124,"text":"if e.key == pygame.K_ESCAPE:"},{"line":125,"text":"running = False"},{"line":126,"text":"elif e.key == pygame.K_SPACE:"},{"line":127,"text":"node.speed = 0.0"},{"line":128,"text":"elif e.key == pygame.K_q:"},{"line":129,"text":"node.speed = 4.0"},{"line":130,"text":"elif e.key == pygame.K_e:"},{"line":131,"text":"node.speed = 10.0"},{"line":132,"text":"elif e.type == pygame.KEYUP:"},{"line":133,"text":"held.discard(e.key)"},{"line":134,"text":"elif e.type == pygame.ACTIVEEVENT:"},{"line":135,"text":"if getattr(e, 'gain', 1) == 0:"},{"line":136,"text":"held.clear()"},{"line":137,"text":""},{"line":138,"text":"focused = bool(pygame.key.get_focused())"},{"line":139,"text":""},{"line":140,"text":"# \uac00\uc18d/\ube0c\ub808\uc774\ud06c (\ub458 \ub2e4 \uc548 \ub204\ub974\uba74 \ud604\uc7ac \uc18d\ub3c4 \uc720\uc9c0)"},{"line":141,"text":"if pygame.K_w in held:"},{"line":142,"text":"node.speed = min(MAX_SPEED, node.speed + ACCEL * dt)"},{"line":143,"text":"elif pygame.K_s in held:"},{"line":144,"text":"node.speed = max(MIN_SPEED, node.speed - BRAKE * dt)"},{"line":145,"text":""},{"line":146,"text":"# \uc870\ud5a5: A/D \ub204\ub974\uace0 \uc788\uc73c\uba74 \uc11c\uc11c\ud788 \uc99d\uac00, \ub5bc\uba74 \uc11c\uc11c\ud788 \uc911\uc559 \ubcf5\uadc0"},{"line":147,"text":"left  = pygame.K_a in held"},{"line":148,"text":"right = pygame.K_d in held"},{"line":149,"text":"if left and not right:"},{"line":150,"text":"node.angle = max(-MAX_ANGLE, node.angle - STEER_RATE * dt)"},{"line":151,"text":"elif right and not left:"},{"line":152,"text":"node.angle = min(MAX_ANGLE, node.angle + STEER_RATE * dt)"},{"line":153,"text":"else:"},{"line":154,"text":"node.angle = 0.0"},{"line":155,"text":""},{"line":156,"text":"# \uba85\ub839 \ubc1c\ud589 + \ud654\uba74 \uac31\uc2e0 + ROS \ucf5c\ubc31 1\ud68c \ucc98\ub9ac"},{"line":157,"text":"node.publish()"},{"line":158,"text":"draw(screen, font, big, node.angle, node.speed, focused)"},{"line":159,"text":"rclpy.spin_once(node, timeout_sec=0.0)"}],"member":"track_drive/track_drive/teleop_key.py"},"publisher":{"archive":"/home/a/Downloads/TalkFile_track_drive.zip.zip","line_end":57,"line_start":42,"lines":[{"line":42,"text":"# \ud0a4\ubcf4\ub4dc \uc870\uc885 \ub178\ub4dc: \ud604\uc7ac \uc870\ud5a5\u00b7\uc18d\ub3c4\ub97c \ubaa8\ud130 \ud1a0\ud53d \ub450 \uacf3\uc5d0 \ubc1c\ud589\ud55c\ub2e4."},{"line":43,"text":"class TeleopKey(Node):"},{"line":44,"text":""},{"line":45,"text":"def __init__(self):"},{"line":46,"text":"# \ub178\ub4dc \ucd08\uae30\ud654: \ubaa8\ud130 \ubc1c\ud589\uc790(\ub450 \ud1a0\ud53d) \uc900\ube44, \uc870\ud5a5\u00b7\uc18d\ub3c4 \ucd08\uae30\ud654"},{"line":47,"text":"super().__init__('teleop_key')"},{"line":48,"text":"self.pub_motor = self.create_publisher(Float32MultiArray, '/xycar_motor', 10)"},{"line":49,"text":"self.angle = 0.0"},{"line":50,"text":"self.speed = 0.0"},{"line":51,"text":"self.get_logger().info('teleop_key (GTA style) ready - pygame \ucc3d\uc5d0 \ud3ec\ucee4\uc2a4 \ub450\uace0 WASD')"},{"line":52,"text":""},{"line":53,"text":"def publish(self):"},{"line":54,"text":"# \ud604\uc7ac \uc870\ud5a5\u00b7\uc18d\ub3c4\ub97c \ubaa8\ud130 \uba54\uc2dc\uc9c0\ub85c \ub9cc\ub4e4\uc5b4 \ub450 \ud1a0\ud53d\uc5d0 \ub3d9\uc2dc \ubc1c\ud589"},{"line":55,"text":"m = Float32MultiArray()"},{"line":56,"text":"m.data = [float(self.angle), float(self.speed)]"},{"line":57,"text":"self.pub_motor.publish(m)"}],"member":"track_drive/track_drive/teleop_key.py"}},"topic_match":{"archive_camera_topic":"/usb_cam/image_raw/front","archive_command_topic":"/xycar_motor","bag_topics":["/camera/image_raw